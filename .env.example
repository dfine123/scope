# Required for AI features (schedule parsing, debrief, motto accent)
ANTHROPIC_API_KEY=

# Single-user passcode. If unset, server runs in OPEN MODE (anyone with
# the URL can use it). Always set this in production.
SCOPE_PASSCODE=

# 32+ random chars. Used to sign session cookies. If unset, a fallback
# derived from SCOPE_PASSCODE is used (sessions invalidate when passcode
# changes — fine for single-user).
SCOPE_AUTH_SECRET=

# Override the Claude model (optional)
SCOPE_CLAUDE_MODEL=claude-sonnet-4-20250514

# Server port (Railway sets PORT automatically)
PORT=3000

# Where the SQLite file lives. On Railway, point this at the mounted
# persistent volume (e.g. /data/scope.db).
SCOPE_DB_PATH=./data/scope.db
